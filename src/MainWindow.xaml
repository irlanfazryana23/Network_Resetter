<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Resetter" Width="840" Height="800" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F5F7FC" FontFamily="Segoe UI"
        FontSize="13" Foreground="#172443" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#63718A"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#243451"/>
      <Setter Property="BorderBrush" Value="#DCE2EE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FF8900"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#102AAF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#102AAF"/>
    </Style>
    <Style x:Key="ModeCard" TargetType="RadioButton">
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Card" BorderBrush="#DDE3EE" BorderThickness="2" CornerRadius="8" Background="White" Padding="14">
              <Grid>
                <ContentPresenter/>
                <Border x:Name="Dot" Width="19" Height="19" CornerRadius="10" BorderBrush="#BAC4D7" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                  <Ellipse x:Name="Inner" Fill="Transparent" Margin="3"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#EEF2FF"/><Setter TargetName="Card" Property="BorderBrush" Value="#1734BB"/><Setter TargetName="Dot" Property="BorderBrush" Value="#1734BB"/><Setter TargetName="Inner" Property="Fill" Value="#1734BB"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#6F82D1"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#FF8900"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E0E6F0" BorderThickness="0,0,0,1" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="BrandLogo" Width="40" Height="40" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Network Resetter" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock Text="DNS and IP repair" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
        <Button x:Name="HelpButton" Grid.Column="2" Content="Help" VerticalAlignment="Center" Padding="14,8"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20,24,20">
        <Border Background="White" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Connection" FontWeight="SemiBold" FontSize="17"/>
                <TextBlock Text="Check IP and DNS settings." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
              </StackPanel>
              <Button x:Name="CheckButton" Grid.Column="1" Content="Check" VerticalAlignment="Center" Padding="20,9"
                      ToolTip="Read adapter settings and look up www.microsoft.com. No settings are changed."/>
            </Grid>
            <Label Content="Network adapter" Target="{Binding ElementName=Connections}" FontSize="12" Padding="0" Margin="0,14,0,6"/>
            <ComboBox x:Name="Connections" IsEnabled="False" MinHeight="34" Padding="8,5" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Network adapter"/>
            <TextBlock x:Name="ConnectionAdvice" Text="Select Check to find your connection." TextWrapping="Wrap" FontSize="12" Foreground="#314982" Margin="0,10,0,0" LineHeight="19"/>
            <Expander x:Name="ConnectionDetails" Header="Connection details" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Muted}">
              <StackPanel Margin="0,8,0,0">
                <TextBlock x:Name="ConnectionSummary" Text="Not checked." TextWrapping="Wrap" LineHeight="19"/>
                <TextBlock x:Name="DnsResult" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="Repair" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="SelectedModeText" Text="Selected: Quick repair" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid x:Name="ModeSelector">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <RadioButton x:Name="BasicMode" GroupName="Mode" Style="{StaticResource ModeCard}" IsChecked="True" AutomationProperties.Name="Quick repair, recommended">
            <StackPanel Margin="0,0,24,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quick repair" FontSize="15" FontWeight="SemiBold"/>
                <Border Background="#E1E8FA" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                  <TextBlock Text="Recommended" FontSize="10" Foreground="#1734BB"/>
                </Border>
              </StackPanel>
              <TextBlock Text="Clear DNS cache and refresh your automatic IP address." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0" LineHeight="19"/>
            </StackPanel>
          </RadioButton>
          <Expander x:Name="AdvancedOptions" Grid.Row="1" Header="Advanced repairs" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource Muted}">
            <StackPanel Margin="0,10,0,0">
              <RadioButton x:Name="StackMode" GroupName="Mode" Style="{StaticResource ModeCard}" AutomationProperties.Name="Winsock reset, restart required">
                <StackPanel Margin="0,0,24,0">
                  <TextBlock Text="Winsock reset" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="Reset Windows network sockets. Requires a restart." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="AggressiveMode" GroupName="Mode" Style="{StaticResource ModeCard}" Margin="0,8,0,0" AutomationProperties.Name="Full adapter reset, last resort">
                <StackPanel Margin="0,0,24,0">
                  <TextBlock Text="Full adapter reset" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="Remove all network adapters. Last resort; requires a restart." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Expander>
        </Grid>
        <Border x:Name="ImpactPanel" Background="#EDF1F7" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,12,0,10">
          <TextBlock x:Name="ImpactText" TextWrapping="Wrap" FontSize="12" Foreground="#455471" LineHeight="19"/>
        </Border>
        <CheckBox x:Name="RenewDhcp" IsChecked="True" Margin="2,0,0,8" VerticalContentAlignment="Center" FontSize="12"
                  ToolTip="Available for connected adapters using automatic IPv4 settings. Clear this option to repair DNS cache only."
                  ToolTipService.ShowOnDisabled="True">
          <TextBlock Text="Renew automatic IP (DHCP)" TextWrapping="Wrap"/>
        </CheckBox>
        <CheckBox x:Name="Acknowledge" Margin="2,0,0,8" Visibility="Collapsed" VerticalContentAlignment="Center" FontSize="12">
          <TextBlock Text="I understand this affects all connections and requires a restart." TextWrapping="Wrap"/>
        </CheckBox>
        <Expander x:Name="StepsExpander" Margin="0,12,0,0">
          <Expander.Header>
            <StackPanel Orientation="Horizontal"><TextBlock Text="Repair steps"/><TextBlock x:Name="StepCount" Foreground="{StaticResource Muted}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"/></StackPanel>
          </Expander.Header>
          <Border Background="White" CornerRadius="8" BorderBrush="#E0E6F0" BorderThickness="1" Padding="14,4" Margin="0,10,0,0">
            <ItemsControl x:Name="StepList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" Background="#EDF1F9" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{Binding Color}"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,10,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{Binding Color}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </Expander>
        <Border x:Name="ResultPanel" Visibility="Collapsed" Background="White" BorderBrush="#E0E6F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Next steps" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock x:Name="NextSteps" TextWrapping="Wrap" LineHeight="21" FontSize="12" Margin="0,8,0,12"/>
            <Button x:Name="NewSession" Content="Other repairs" HorizontalAlignment="Left" Visibility="Collapsed" Padding="12,8"/>
          </StackPanel>
        </Border>
        <Expander x:Name="LogExpander" Header="Activity log" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource Muted}">
          <StackPanel>
            <TextBox x:Name="ActivityLog" Margin="0,10,0,0" Height="160" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#152039" Foreground="#D6E1F8" BorderThickness="0" Padding="12" AutomationProperties.Name="Activity log"/>
            <TextBlock x:Name="SessionPath" Text="Settings and logs are saved when a repair starts." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="White" BorderBrush="#E0E6F0" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock x:Name="StatusTitle" Text="Ready" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusDetail" Text="Check the connection before repairing." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
          </StackPanel>
          <TextBlock x:Name="ProgressLabel" Grid.Column="1" Text="Ready" VerticalAlignment="Center" Foreground="#1734BB" FontSize="11"/>
        </Grid>
        <ProgressBar x:Name="Progress" Height="3" Foreground="#1734BB" Background="#EBEFF7" BorderThickness="0" Maximum="100" Margin="0,0,0,12"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="OpenLogs" Content="Open logs" IsEnabled="False" HorizontalAlignment="Left" Padding="12,9"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="RestartButton" Content="Restart..." Margin="0,0,8,0" Visibility="Collapsed" Padding="12,9"/>
            <Button x:Name="RunButton" Content="Repair" Style="{StaticResource PrimaryButton}" MinWidth="110" Padding="16,9"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
